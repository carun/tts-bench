      "synth_seconds": 2.4469,
      "audio_seconds": 4.32,
      "rtf": 0.5664,
      "sample_rate": 24000,
      "peak_abs": 0.7695
    },
    {
      "id": "heteronyms_01",
      "category": "heteronyms",
      "text": "The lead engineer removed the lead pipe from the basement.",

      "synth_seconds": 3.4324,
      "audio_seconds": 6.0,
      "rtf": 0.5721,
      "sample_rate": 24000,
      "peak_abs": 0.668
    },
    {
      "id": "heteronyms_00",
      "category": "heteronyms",
      "text": "I read the report yesterday, and I will read the summary tonight.",

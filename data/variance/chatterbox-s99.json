      "synth_seconds": 2.4004,
      "audio_seconds": 5.2,
      "rtf": 0.4616,
      "sample_rate": 24000,
      "peak_abs": 0.8996
    },
    {
      "id": "complex_03",
      "category": "complex",
      "text": "What surprised us was not that it failed, but how long it took anyone to notice.",

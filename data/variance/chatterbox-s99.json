    {
      "id": "complex_00",
      "category": "complex",
      "text": "Although the tests passed locally, the build failed in CI, which nobody noticed until Monday.",
      "wav": "/work/out/chatterbox-s99/complex_00.wav",
      "synth_seconds": 2.2628,
      "audio_seconds": 4.92,

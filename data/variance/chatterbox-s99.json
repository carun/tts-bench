      "sample_rate": 24000,
      "peak_abs": 1.0025
    },
    {
      "id": "complex_01",
      "category": "complex",
      "text": "The report, which had been delayed twice already, finally arrived without the appendix.",
      "wav": "/work/out/chatterbox-s99/complex_01.wav",
      "synth_seconds": 1.9672,
      "audio_seconds": 4.2,

      "sample_rate": 24000,
      "peak_abs": 0.9838
    },
    {
      "id": "complex_01",
      "category": "complex",
      "text": "The report, which had been delayed twice already, finally arrived without the appendix.",
      "wav": "/work/out/chatterbox-s7/complex_01.wav",
      "synth_seconds": 1.9803,
      "audio_seconds": 4.2,

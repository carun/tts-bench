    },
    {
      "id": "acronyms_04",
      "category": "acronyms",
      "text": "She works for the FBI, not the CIA.",
      "wav": "/work/out/chatterbox-turbo-s7/acronyms_04.wav",
      "synth_seconds": 0.7568,
      "audio_seconds": 2.92,

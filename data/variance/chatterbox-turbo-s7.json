      "sample_rate": 24000,
      "peak_abs": 0.6171
    },
    {
      "id": "prose_02",
      "category": "prose",
      "text": "She left a note on the counter saying she would be back by six.",
      "wav": "/work/out/chatterbox-turbo-s7/prose_02.wav",
      "synth_seconds": 0.8446,
      "audio_seconds": 3.32,
      "rtf": 0.2544,
      "sample_rate": 24000,
      "peak_abs": 0.3926
    },
    {
      "id": "prose_03",
      "category": "prose",
      "text": "Most of the work happens before anyone writes a single line of code.",

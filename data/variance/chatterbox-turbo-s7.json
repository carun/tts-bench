      "synth_seconds": 0.7936,
      "audio_seconds": 3.12,
      "rtf": 0.2544,
      "sample_rate": 24000,
      "peak_abs": 0.5223
    },
    {
      "id": "prose_06",
      "category": "prose",
      "text": "The weather turned just as we were about to leave the house.",
      "wav": "/work/out/chatterbox-turbo-s7/prose_06.wav",
      "synth_seconds": 0.7469,
      "audio_seconds": 2.92,
      "rtf": 0.2558,
      "sample_rate": 24000,
      "peak_abs": 0.3403
    },
    {
      "id": "prose_07",
      "category": "prose",

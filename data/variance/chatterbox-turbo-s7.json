      "synth_seconds": 0.9149,
      "audio_seconds": 3.64,
      "rtf": 0.2513,
      "sample_rate": 24000,
      "peak_abs": 0.3986
    },
    {
      "id": "jargon_04",
      "category": "jargon",
      "text": "Quantisation shrank the checkpoint without measurably hurting accuracy.",
      "wav": "/work/out/chatterbox-turbo-s7/jargon_04.wav",

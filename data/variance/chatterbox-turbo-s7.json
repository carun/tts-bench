      "sample_rate": 24000,
      "peak_abs": 0.3386
    },
    {
      "id": "jargon_00",
      "category": "jargon",
      "text": "The inference sidecar queues contributions until the GPU responds.",
      "wav": "/work/out/chatterbox-turbo-s7/jargon_00.wav",
      "synth_seconds": 1.0328,
      "audio_seconds": 4.16,
      "rtf": 0.2483,
      "sample_rate": 24000,
      "peak_abs": 0.4024
    },
    {
      "id": "jargon_01",
      "category": "jargon",
      "text": "Speaker diarization splits the recording into turns before transcription.",

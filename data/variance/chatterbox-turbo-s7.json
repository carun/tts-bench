      "synth_seconds": 1.0485,
      "audio_seconds": 4.2,
      "rtf": 0.2497,
      "sample_rate": 24000,
      "peak_abs": 0.4321
    },
    {
      "id": "prose_04",
      "category": "prose",
      "text": "There is a difference between being busy and being useful.",
      "wav": "/work/out/chatterbox-turbo-s7/prose_04.wav",
      "synth_seconds": 0.7593,
      "audio_seconds": 2.96,
      "rtf": 0.2565,
      "sample_rate": 24000,
      "peak_abs": 0.2311
    },
    {
      "id": "prose_05",
      "category": "prose",
      "text": "He asked whether the results had been checked by anyone else.",

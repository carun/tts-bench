      "synth_seconds": 0.8319,
      "audio_seconds": 3.24,
      "rtf": 0.2567,
      "sample_rate": 24000,
      "peak_abs": 0.3199
    },
    {
      "id": "prose_06",
      "category": "prose",
      "text": "The weather turned just as we were about to leave the house.",

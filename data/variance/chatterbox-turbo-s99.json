      "sample_rate": 24000,
      "peak_abs": 0.4791
    },
    {
      "id": "prose_02",
      "category": "prose",
      "text": "She left a note on the counter saying she would be back by six.",
      "wav": "/work/out/chatterbox-turbo-s99/prose_02.wav",
      "synth_seconds": 0.8323,
      "audio_seconds": 3.24,
      "rtf": 0.2569,
      "sample_rate": 24000,
      "peak_abs": 0.3332
    },
    {
      "id": "prose_03",
      "category": "prose",
      "text": "Most of the work happens before anyone writes a single line of code.",

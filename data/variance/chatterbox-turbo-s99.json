      "synth_seconds": 0.9514,
      "audio_seconds": 3.76,
      "rtf": 0.253,
      "sample_rate": 24000,
      "peak_abs": 0.4479
    },
    {
      "id": "prose_04",
      "category": "prose",
      "text": "There is a difference between being busy and being useful.",
      "wav": "/work/out/chatterbox-turbo-s99/prose_04.wav",
      "synth_seconds": 0.7796,
      "audio_seconds": 3.04,
      "rtf": 0.2564,
      "sample_rate": 24000,
      "peak_abs": 0.2579
    },
    {
      "id": "prose_05",
      "category": "prose",
      "text": "He asked whether the results had been checked by anyone else.",

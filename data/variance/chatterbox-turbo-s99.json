      "synth_seconds": 0.7977,
      "audio_seconds": 3.12,
      "rtf": 0.2557,
      "sample_rate": 24000,
      "peak_abs": 0.3561
    },
    {
      "id": "heteronyms_06",
      "category": "heteronyms",
      "text": "We must record the meeting and file the record with the board.",
      "wav": "/work/out/chatterbox-turbo-s99/heteronyms_06.wav",
      "synth_seconds": 0.7659,
      "audio_seconds": 2.96,
      "rtf": 0.2588,
      "sample_rate": 24000,
      "peak_abs": 0.3513
    },
    {
      "id": "heteronyms_07",
      "category": "heteronyms",
      "text": "The wind was strong enough to wind the flag around the pole.",
      "wav": "/work/out/chatterbox-turbo-s99/heteronyms_07.wav",
      "synth_seconds": 0.7978,
      "audio_seconds": 3.08,

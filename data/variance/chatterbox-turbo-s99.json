      "sample_rate": 24000,
      "peak_abs": 0.3134
    },
    {
      "id": "jargon_00",
      "category": "jargon",
      "text": "The inference sidecar queues contributions until the GPU responds.",
      "wav": "/work/out/chatterbox-turbo-s99/jargon_00.wav",
      "synth_seconds": 0.947,
      "audio_seconds": 3.76,

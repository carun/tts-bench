      "sample_rate": 24000,
      "peak_abs": 0.5984
    },
    {
      "id": "acronyms_07",
      "category": "acronyms",
      "text": "Attach the CSV and the JSON export to the same email.",
      "wav": "/work/out/chatterbox-turbo-s99/acronyms_07.wav",
      "synth_seconds": 1.0062,
      "audio_seconds": 4.0,
      "rtf": 0.2515,

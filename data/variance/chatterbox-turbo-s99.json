      "synth_seconds": 0.9205,
      "audio_seconds": 3.6,
      "rtf": 0.2557,
      "sample_rate": 24000,
      "peak_abs": 0.3358
    },
    {
      "id": "heteronyms_04",
      "category": "heteronyms",
      "text": "Please close the door; the exit is close to the stairwell.",
      "wav": "/work/out/chatterbox-turbo-s99/heteronyms_04.wav",
      "synth_seconds": 0.8625,
      "audio_seconds": 3.36,
      "rtf": 0.2567,
      "sample_rate": 24000,
      "peak_abs": 0.3132
    },
    {
      "id": "heteronyms_05",
      "category": "heteronyms",
      "text": "The dove dove straight into the hedge without slowing down.",

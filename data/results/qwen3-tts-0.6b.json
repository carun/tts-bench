      "synth_seconds": 2.7764,
      "audio_seconds": 4.72,
      "rtf": 0.5882,
      "sample_rate": 24000,
      "peak_abs": 0.7539
    },
    {
      "id": "heteronyms_00",
      "category": "heteronyms",
      "text": "I read the report yesterday, and I will read the summary tonight.",
      "wav": "/work/out/qwen3-tts-0.6b/heteronyms_00.wav",
      "synth_seconds": 2.3019,
      "audio_seconds": 3.92,
      "rtf": 0.5872,
      "sample_rate": 24000,
      "peak_abs": 0.668
    },
    {
      "id": "heteronyms_01",
      "category": "heteronyms",
      "text": "The lead engineer removed the lead pipe from the basement.",

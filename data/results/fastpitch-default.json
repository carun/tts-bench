      "synth_seconds": 0.0505,
      "audio_seconds": 5.6889,
      "rtf": 0.0089,
      "sample_rate": 22050,
      "peak_abs": 0.5034
    },
    {
      "id": "heteronyms_00",
      "category": "heteronyms",
      "text": "I read the report yesterday, and I will read the summary tonight.",

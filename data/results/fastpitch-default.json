      "synth_seconds": 0.0575,
      "audio_seconds": 6.5016,
      "rtf": 0.0088,
      "sample_rate": 22050,
      "peak_abs": 0.4401
    },
    {
      "id": "complex_07",
      "category": "complex",
      "text": "She wanted to know why, given everything that had happened, we were still shipping on Friday.",

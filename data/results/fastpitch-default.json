      "synth_seconds": 0.0375,
      "audio_seconds": 4.7833,
      "rtf": 0.0078,
      "sample_rate": 22050,
      "peak_abs": 0.4445
    },
    {
      "id": "complex_05",
      "category": "complex",
      "text": "The system works — assuming, of course, that the cache has been warmed first.",
      "wav": "/work/out/fastpitch-default/complex_05.wav",
      "synth_seconds": 0.0353,
      "audio_seconds": 4.4582,
      "rtf": 0.0079,
      "sample_rate": 22050,
      "peak_abs": 0.5788
    },
    {
      "id": "complex_06",
      "category": "complex",
      "text": "Before deploying, verify the image was rebuilt; a stale image looks identical from outside.",
